# ==============================================================================
# Sfinx AI Environment Variables Example
# Copy this file to `.env.local` and fill in your configuration values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Required Services
# ------------------------------------------------------------------------------

# OpenAI API Key (Required for AI interviewer voice & evaluation pipeline)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Model used for real-time answer evaluation & scoring (default: gpt-4o-mini)
NEXT_PUBLIC_OPENAI_EVALUATION_MODEL=gpt-4o-mini

# PostgreSQL Database Connection URL (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/sfinx?sslmode=disable"

# Seed User Password (Used by `pnpm setup:companies:dev` / `pnpm seed:prod`)
SEED_USER_PASSWORD="sfinx"

# NextAuth Authentication Config
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-nextauth-secret-32-chars-min"

# ------------------------------------------------------------------------------
# Optional Integrations
# ------------------------------------------------------------------------------

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ElevenLabs Text-to-Speech (Optional — enabled via NEXT_PUBLIC_TTS_ENABLED)
NEXT_PUBLIC_TTS_ENABLED=false
ELEVENLABS_API_KEY=""
ELEVEN_LABS_CANDIDATE_VOICE_ID="wJqPPQ618aTW29mptyoc"

# Rive Animated Mascot (Optional — enabled via NEXT_PUBLIC_MASCOT_ENABLED)
NEXT_PUBLIC_MASCOT_ENABLED=false
MASCOTBOT_API_KEY=""

# Vercel Blob Storage (Optional — for video recording uploads)
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------------------
# Feature Flags & Business Logic Configuration
# ------------------------------------------------------------------------------

NEXT_PUBLIC_AUTOMATIC_MODE=true
NEXT_PUBLIC_USE_SPLIT_EVALUATION=true
NEXT_PUBLIC_SKIP_SCREEN_SHARE=false
NEXT_PUBLIC_SKIP_TO_CODING=false
NEXT_PUBLIC_CAMERA_AUTO_START=true
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_ALLOW_NON_EDITOR_PASTE=true

# Interview stage throttles and target counts
NEXT_PUBLIC_CODE_EVALUATION_THROTTLE_MS=3000
NEXT_PUBLIC_MAX_PASTE_TOPICS=3
NEXT_PUBLIC_MAX_PASTE_QUESTIONS=3
NEXT_PUBLIC_DONT_KNOW_THRESHOLD=2
NEXT_PUBLIC_CONTRIBUTIONS_TARGET=5
NEXT_PUBLIC_CLARIFICATION_THRESHOLD=3
NEXT_PUBLIC_SPINNER_CENTER_TYPE=breathing
